rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuthenticated() && userRole() == 'admin';
    }

    function isBilling() {
      return isAuthenticated() && userRole() == 'billing';
    }

    function isMechanic() {
      return isAuthenticated() && userRole() == 'mechanic';
    }

    function isAccountant() {
      return isAuthenticated() && userRole() == 'accountant';
    }

    function isStaff() {
      return isAdmin() || isBilling() || isMechanic() || isAccountant();
    }

    match /settings/{docId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /customers/{customerId} {
      allow read: if isStaff();
      allow create, update, delete: if isAdmin() || isBilling();
    }

    match /vehicles/{vehicleId} {
      allow read: if isStaff();
      allow create, update, delete: if isAdmin() || isBilling();
    }

    match /stock_items/{itemId} {
      allow read: if isStaff();
      allow create, update, delete: if isAdmin() || isBilling();
    }

    match /labour_items/{itemId} {
      allow read: if isStaff();
      allow create, update, delete: if isAdmin() || isBilling();
    }

    match /stock_transactions/{txId} {
      allow read: if isStaff();
      allow create: if isAdmin() || isBilling();
      allow update, delete: if isAdmin();
    }

    match /jobcards/{jobcardId} {
      allow read: if isStaff();
      allow create: if isAdmin() || isBilling();
      allow update: if isAdmin() || isBilling() || isMechanic();
      allow delete: if isAdmin();
    }

    match /invoices/{invoiceId} {
      allow read: if isStaff();
      allow create: if isAdmin() || isBilling();
      allow update: if isAdmin() || isBilling() || isAccountant();
      allow delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isStaff();
      allow create, update: if isAdmin() || isBilling() || isAccountant();
      allow delete: if isAdmin();
    }

    match /estimates/{estimateId} {
      allow read: if isStaff();
      allow create, update: if isAdmin() || isBilling();
      allow delete: if isAdmin();
    }
  }
}
